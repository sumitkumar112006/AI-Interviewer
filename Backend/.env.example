# Backend Environment Variables
# Copy this file to .env and fill in your actual values

NODE_ENV=production
PORT=3000

# Database (MongoDB)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/interview-master

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars

# Google Generative AI API Key
GOOGLE_GENAI_API_KEY=your-google-genai-api-key-here

# CORS Origin (Frontend URL)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Supabase Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# OpenTelemetry & Grafana Cloud Observability Configuration
# Service name identifier
OTEL_SERVICE_NAME=kivi-backend
DEPLOYMENT_ENVIRONMENT=production

# Exporters: "otlp" (default) or "none" to disable exporting
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Metrics Exporter: "none" (default) or "otlp" to enable metrics export to Grafana Mimir
OTEL_METRICS_EXPORTER=none

# Application Log Level: "debug" (dev default), "info" (production default), "warn", "error"
LOG_LEVEL=info

# -----------------------------------------------------------------------------------------
# Option A: Local OpenTelemetry Collector or Local Dev (default: http://localhost:4318)
# -----------------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# -----------------------------------------------------------------------------------------
# Option B: Direct Grafana Cloud OTLP Gateway (Production)
# 1. In Grafana Cloud, navigate to: Connections -> OpenTelemetry -> Configure
# 2. Copy your OTLP Gateway Endpoint (e.g., https://otlp-gateway-prod-us-east-0.grafana.net/otlp)
# 3. Create a Grafana Cloud Access Policy Token with scopes: traces:write, metrics:write, logs:write
# 4. Generate Basic Auth header: base64(INSTANCE_ID:TOKEN)
#    (e.g., in Node: Buffer.from(`${INSTANCE_ID}:${TOKEN}`).toString('base64'))
# -----------------------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:access_policy_token)>

# -----------------------------------------------------------------------------------------
# Production Sampling Configuration
# - Local / Development / Staging: parentbased_always_on (100% sampling)
# - High-Traffic Production: parentbased_traceidratio with arg 0.1 (10%) or 0.25 (25%)
# -----------------------------------------------------------------------------------------
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Master kill-switch to completely disable OpenTelemetry SDK without code changes
# OTEL_SDK_DISABLED=true
